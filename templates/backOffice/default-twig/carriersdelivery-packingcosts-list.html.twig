{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'CarriersDelivery'|trans({}, 'carriersdelivery.bo.default') }}{% endblock %}

{% block content %}
    <div class="carriersdelivery">
        <div id="wrapper" class="container">
            {% include '@CarriersDeliveryModule/backOffice/default-twig/CarriersDelivery/includes/carriersdelivery-menu.html.twig' with {'menu_active': 'packingcosts'} %}

            <div class="card">
                <div class="card-body">
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type }}">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}

                    <h1 class="h4 mb-3">{{ 'Packing costs list'|trans({}, 'carriersdelivery.bo.default') }}</h1>

                    <div class="table-responsive">
                        <table class="table table-striped table-sm" style="max-width: 600px;">
                            <thead>
                                <tr>
                                    <th>{{ 'Weight max'|trans({}, 'carriersdelivery.bo.default') }} <small>(Kg)</small></th>
                                    <th>{{ 'Cost'|trans({}, 'carriersdelivery.bo.default') }} <small>({{ currency_symbol }})</small></th>
                                    <th class="text-end">{{ 'Actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for pc in packingcosts %}
                                    <tr class="slice" data-id="{{ pc.id }}">
                                        <td class="weight-max">
                                            <input type="text" class="form-control form-control-sm" value="{{ pc.weight_max|number_format(2, '.', ' ') }}">
                                        </td>
                                        <td class="cost">
                                            <input type="text" class="form-control form-control-sm" value="{{ pc.cost|number_format(2, '.', ' ') }}">
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group">
                                                {% if is_granted('UPDATE', {resource: 'admin.module', module: 'CarriersDelivery'}) %}
                                                    <button type="button" class="btn btn-secondary btn-sm update d-none" title="{{ 'Save'|trans }}">
                                                        <i class="bi bi-floppy"></i>
                                                    </button>
                                                {% endif %}
                                                {% if is_granted('DELETE', {resource: 'admin.module', module: 'CarriersDelivery'}) %}
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm packingcost-delete"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#carriersdelivery-packingcost-delete-modal">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                {% if is_granted('CREATE', {resource: 'admin.module', module: 'CarriersDelivery'}) %}
                                    <tr class="slice-add">
                                        <td class="weight-max">
                                            <input type="text" class="form-control form-control-sm" value="" placeholder="{{ 'Weight max'|trans({}, 'carriersdelivery.bo.default') }} (Kg)">
                                        </td>
                                        <td class="cost">
                                            <input type="text" class="form-control form-control-sm" value="" placeholder="{{ 'Cost'|trans({}, 'carriersdelivery.bo.default') }} ({{ currency_symbol }})">
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group">
                                                <button type="button" class="btn btn-primary btn-sm" id="packingcost-add-btn" title="{{ 'Add'|trans }}">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Delete modal #}
    {% if is_granted('DELETE', {resource: 'admin.module', module: 'CarriersDelivery'}) %}
        <div class="modal fade" id="carriersdelivery-packingcost-delete-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Delete this packing cost'|trans({}, 'carriersdelivery.bo.default') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form method="POST" action="{{ path('carriersdelivery.admin.packingcost.delete') }}?_token={{ assignToken() }}">
                        <div class="modal-body">
                            <p>{{ 'Do you really want to delete this packing cost?'|trans({}, 'carriersdelivery.bo.default') }}</p>
                            <input type="hidden" name="packingcost_id" id="carriersdelivery-packingcost-delete-id" value="">
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                            <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}

    {# Hidden AJAX forms for create/edit — use prefixed names to match validateForm() #}
    {% set cf_name = create_form.vars.full_name %}
    <form id="packingcost-create-form" style="display:none"
          method="POST" action="{{ path('carriersdelivery.admin.packingcost.create') }}">
        <input type="hidden" name="{{ create_form._token.vars.full_name }}" id="pc-create-token" value="{{ create_form._token.vars.value }}">
        <input type="hidden" name="{{ cf_name }}[weight_max]" id="pc-create-weight_max">
        <input type="hidden" name="{{ cf_name }}[cost]" id="pc-create-cost">
    </form>

    {% set ef_name = edit_form.vars.full_name %}
    <form id="packingcost-edit-form" style="display:none"
          method="POST" action="{{ path('carriersdelivery.admin.packingcost.edit') }}">
        <input type="hidden" name="{{ edit_form._token.vars.full_name }}" id="pc-edit-token" value="{{ edit_form._token.vars.value }}">
        <input type="hidden" name="{{ ef_name }}[id]" id="pc-edit-id">
        <input type="hidden" name="{{ ef_name }}[weight_max]" id="pc-edit-weight_max">
        <input type="hidden" name="{{ ef_name }}[cost]" id="pc-edit-cost">
    </form>
{% endblock %}

{% block scripts_extra %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var listUrl = {{ path('carriersdelivery.admin.packingcosts')|json_encode|raw }};

            function packingcostAjax(formEl) {
                fetch(formEl.action, {
                    method: 'POST',
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                    body: new URLSearchParams(new FormData(formEl))
                }).then(function (r) { return r.json(); })
                  .then(function (data) {
                      alert(data.message);
                      if (data.success) { window.location.replace(listUrl); }
                  })
                  .catch(function () { alert('Error'); });
            }

            {# Delete modal: populate id #}
            var deleteModal = document.getElementById('carriersdelivery-packingcost-delete-modal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    var row = event.relatedTarget.closest('tr.slice');
                    document.getElementById('carriersdelivery-packingcost-delete-id').value = row.getAttribute('data-id');
                });
            }

            {# Add button: submit create form via AJAX #}
            var addBtn = document.getElementById('packingcost-add-btn');
            if (addBtn) {
                addBtn.addEventListener('click', function () {
                    var sliceAdd = this.closest('tr.slice-add');
                    document.getElementById('pc-create-weight_max').value = sliceAdd.querySelector('td.weight-max input').value;
                    document.getElementById('pc-create-cost').value = sliceAdd.querySelector('td.cost input').value;
                    packingcostAjax(document.getElementById('packingcost-create-form'));
                });
            }

            {# Save button per row: submit edit form via AJAX #}
            document.querySelectorAll('#wrapper tr.slice .actions button.update').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var row = this.closest('tr.slice');
                    document.getElementById('pc-edit-id').value = row.getAttribute('data-id');
                    document.getElementById('pc-edit-weight_max').value = row.querySelector('td.weight-max input').value;
                    document.getElementById('pc-edit-cost').value = row.querySelector('td.cost input').value;
                    packingcostAjax(document.getElementById('packingcost-edit-form'));
                });
            });

            {# Show save button when an input changes #}
            document.querySelectorAll('#wrapper tr.slice input').forEach(function (input) {
                input.addEventListener('change', function () {
                    this.closest('tr').querySelectorAll('td.text-end button.update').forEach(function (b) {
                        b.classList.remove('d-none');
                    });
                });
            });
        });
    </script>
{% endblock %}
