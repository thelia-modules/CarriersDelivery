{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'CarriersDelivery'|trans({}, 'carriersdelivery.bo.default') }}{% endblock %}

{% block content %}
    <div class="carriersdelivery">
        <div id="wrapper" class="container">
            {% include '@CarriersDeliveryModule/backOffice/default-twig/CarriersDelivery/includes/carriersdelivery-menu.html.twig' with {'menu_active': 'carriers'} %}

            <div class="card">
                <div class="card-body">
                    <h1 class="h4 mb-3">{{ 'Edit carrier\'s informations (%id)'|trans({'%id': carrier_id}, 'carriersdelivery.bo.default') }}</h1>

                    {% if edit_form is not null %}
                        {% set form_name = edit_form.vars.full_name %}
                        <form class="form-horizontal" method="POST" action="{{ path('carriersdelivery.admin.carrier.edit') }}">
                            <input type="hidden" name="{{ edit_form._token.vars.full_name }}" value="{{ edit_form._token.vars.value }}">
                            <input type="hidden" name="{{ form_name }}[success_url]" value="{{ path('carriersdelivery.admin.carriers') }}">
                            {% do edit_form._token.setRendered %}

                            <div style="max-width: 900px; margin: 0 auto;">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            {{ form_label(edit_form.name, null, {label_attr: {class: 'form-label'}}) }}
                                            {{ form_widget(edit_form.name, {attr: {class: 'form-control' ~ (edit_form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                                            {{ form_errors(edit_form.name) }}
                                        </div>
                                        <div class="mb-3">
                                            {{ form_label(edit_form.country_id, null, {label_attr: {class: 'form-label'}}) }}
                                            {{ form_widget(edit_form.country_id, {attr: {class: 'form-select' ~ (edit_form.country_id.vars.errors|length ? ' is-invalid' : '')}}) }}
                                            {{ form_errors(edit_form.country_id) }}
                                        </div>
                                    </div>
                                    <div class="col-md-3 offset-md-1">
                                        <div class="mb-3">
                                            {{ form_label(edit_form.diesel_tax_percent, null, {label_attr: {class: 'form-label'}}) }}
                                            {{ form_widget(edit_form.diesel_tax_percent, {attr: {class: 'form-control' ~ (edit_form.diesel_tax_percent.vars.errors|length ? ' is-invalid' : '')}}) }}
                                            {{ form_errors(edit_form.diesel_tax_percent) }}
                                        </div>
                                        <div class="mb-3">
                                            {{ form_label(edit_form.fees_cost, null, {label_attr: {class: 'form-label'}}) }}
                                            {{ form_widget(edit_form.fees_cost, {attr: {class: 'form-control' ~ (edit_form.fees_cost.vars.errors|length ? ' is-invalid' : '')}}) }}
                                            {{ form_errors(edit_form.fees_cost) }}
                                        </div>
                                    </div>
                                    <div class="col-md-3 offset-md-1">
                                        <div class="mb-3">
                                            {{ form_label(edit_form.unit_per_kg, null, {label_attr: {class: 'form-label'}}) }}
                                            {{ form_widget(edit_form.unit_per_kg, {attr: {class: 'form-control' ~ (edit_form.unit_per_kg.vars.errors|length ? ' is-invalid' : '')}}) }}
                                            {{ form_errors(edit_form.unit_per_kg) }}
                                        </div>
                                        <a class="btn btn-secondary" href="{{ path('carriersdelivery.admin.carrier.areas', {carrier_id: carrier_id}) }}">
                                            {{ 'See areas'|trans({}, 'carriersdelivery.bo.default') }} <i class="bi bi-tags"></i>
                                        </a>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-4">
                                    <a class="btn btn-secondary" href="{{ path('carriersdelivery.admin.carriers') }}">{{ 'Close'|trans }}</a>
                                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>{{ 'Save'|trans }}</button>
                                </div>

                                {{ form_rest(edit_form) }}
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
