{# The product form is rendered without its rest: the carrier field added by the module is rendered here by hand. #}
<div class="mb-3 carrier-field-group">
    <label class="form-label">{{ 'Choose a carrier'|trans({}, 'carriersdelivery.bo.default') }}</label>
    {% for carrier_id, carrier_name in carriers %}
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="thelia_product_modification_carrier_id_{{ carrier_id }}"
                   name="thelia_product_modification[carrier_id][]" value="{{ carrier_id }}"{{ carrier_id in selected_carrier_ids ? ' checked' }}>
            <label class="form-check-label" for="thelia_product_modification_carrier_id_{{ carrier_id }}">{{ carrier_name }}</label>
        </div>
    {% else %}
        <p class="form-text text-muted">{{ 'There is no results.'|trans({}, 'carriersdelivery.bo.default') }}</p>
    {% endfor %}
</div>
